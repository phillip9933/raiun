# Local credentials and signing material never belong in this repository.
*.jks
*.keystore
*.p12
*.pfx
*.clixml
signing.properties
local.properties
.env
.env.*
!*.example

# Tool caches and build products; platform rules also live beside their app.
.idea/
.gradle/
.kotlin/
**/build/
__pycache__/
*.pyc
/outputs/
