#!/bin/sh
set -eu
case "${0##*/}" in
  xdg-open) helper=/usr/bin/xdg-open ;;
  fusermount3) helper=/usr/bin/fusermount3 ;;
  *) echo 'Unknown host helper' >&2; exit 1 ;;
esac
for key in PATH LD_LIBRARY_PATH LD_PRELOAD GTK_PATH GTK_EXE_PREFIX GTK_DATA_PREFIX GDK_PIXBUF_MODULE_FILE GSETTINGS_SCHEMA_DIR GI_TYPELIB_PATH WEBKIT_EXEC_PATH WEBKIT_INJECTED_BUNDLE_PATH XDG_DATA_DIRS GST_PLUGIN_SYSTEM_PATH GST_PLUGIN_PATH GST_PLUGIN_SCANNER GDK_BACKEND GTK_THEME; do
  present=$(printenv "RAIUN_APPIMAGE_HOST_${key}_SET" || true)
  if [ "$present" = 1 ]; then
    value=$(printenv "RAIUN_APPIMAGE_HOST_${key}")
    export "$key=$value"
  else unset "$key"; fi
done
unset APPDIR APPIMAGE
exec "$helper" "$@"
